# Entornos virtuales
venv/
env/
.venv/
__pycache__/
*.pyc

# Variables de entorno y credenciales (NUNCA SUBIR)
.env
*.env.local

# Archivos pesados y temporales
documentos_pdf/
documentos_u/
*.pdf
*.png
*.jpg
*.jpeg

# Respaldos de base de datos (contienen datos reales, nunca al repo)
respaldos/

# Cache de embeddings: son datos derivados de una API de pago cuota. No
# pertenece al repo, y ademas versionarla haria el repositorio enorme.
cache_embeddings/

# Graficos del informe: se versionan a proposito, el informe los cita.
# El `*.png` de arriba los excluye, asi que hay que exceptuarlos.
!resultados/*.png

# Datos crudos de benchmark: se regeneran corriendo el benchmark, asi que
# no van al repo. Los PNG de arriba si, porque son la evidencia citada.
resultados/*.json

# Logs y base de datos local si hubiera
*.log
error_build*.txt
.DS_Store
.vscode/

